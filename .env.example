# Copy to .env (never commit .env). Backend reads these at start.

# true = every provider call goes to MockProvider (zero paid calls)
MOCK_MODE=true

# anthropic | gemini
VLM_PROVIDER=anthropic
VLM_API_KEY=

MAPS_API_KEY=

DATABASE_URL=postgresql+psycopg://avn:avn@db:5432/avn
POSTGRES_USER=avn
POSTGRES_PASSWORD=avn
POSTGRES_DB=avn

# Comma-separated per-install keys accepted in the X-API-Key header
APP_API_KEYS=dev-install-key

# Provider timeout in seconds (the app waits this + 1 s)
PROVIDER_TIMEOUT_S=4

LOG_LEVEL=info
