{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avn.local/contracts/event.schema.json",
  "title": "Event",
  "description": "Every producer submits Events to the priority engine. Fields are exactly the spec's. distance_band is never meters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "type", "label", "side", "distance_band", "confidence", "risk", "timestamp"],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]{1,64}$" },
    "source": { "$ref": "common.schema.json#/$defs/Source" },
    "type": { "$ref": "common.schema.json#/$defs/EventType" },
    "label": { "type": "string", "maxLength": 64 },
    "side": { "anyOf": [ { "$ref": "common.schema.json#/$defs/Side" }, { "type": "null" } ] },
    "distance_band": { "anyOf": [ { "$ref": "common.schema.json#/$defs/DistanceBand" }, { "type": "null" } ] },
    "confidence": { "$ref": "common.schema.json#/$defs/Confidence" },
    "risk": { "type": "integer", "minimum": 0, "maximum": 100 },
    "timestamp": { "$ref": "common.schema.json#/$defs/TimestampMs" }
  }
}
