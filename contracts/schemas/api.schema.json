{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avn.local/contracts/api.schema.json",
  "title": "Backend request and response bodies (the 9 endpoints)",
  "description": "Responses are the `data` field of an ApiEnvelope. Field names are proposed in the blueprint and become fixed at the Gate 1 freeze.",
  "$defs": {
    "HealthResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "version", "mock_mode"],
      "properties": {
        "status": { "enum": ["ok", "degraded"] },
        "version": { "type": "string" },
        "mock_mode": { "type": "boolean" }
      }
    },
    "DescribeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "language"],
      "properties": {
        "image": { "$ref": "common.schema.json#/$defs/ImageJpegBase64" },
        "context": { "$ref": "common.schema.json#/$defs/Context" },
        "language": { "$ref": "common.schema.json#/$defs/Language" }
      }
    },
    "DescribeResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["description"],
      "properties": { "description": { "type": "string", "maxLength": 400 } }
    },
    "AskRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "question"],
      "properties": {
        "image": { "$ref": "common.schema.json#/$defs/ImageJpegBase64" },
        "question": { "type": "string", "minLength": 1, "maxLength": 300 },
        "context": { "$ref": "common.schema.json#/$defs/Context" }
      }
    },
    "AskResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["answer"],
      "properties": { "answer": { "type": "string", "maxLength": 600 } }
    },
    "ScreenSummarizeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["package", "screen_type", "text", "question"],
      "properties": {
        "package": { "type": "string", "maxLength": 200 },
        "screen_type": { "$ref": "common.schema.json#/$defs/ScreenType" },
        "text": { "type": "string", "maxLength": 8000 },
        "image": { "$ref": "common.schema.json#/$defs/ImageJpegBase64" },
        "question": { "type": "string", "maxLength": 300 }
      }
    },
    "ScreenSummarizeResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["summary"],
      "properties": { "summary": { "type": "string", "maxLength": 1200 } }
    },
    "IntentRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "context": { "$ref": "common.schema.json#/$defs/Context" }
      }
    },
    "IntentResponse": { "$ref": "android.schema.json#/$defs/ActionPlan" },
    "FacesEnrollRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["display_name", "embedding", "model_version", "consent"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "embedding": { "type": "array", "items": { "type": "number" }, "minItems": 64, "maxItems": 1024 },
        "model_version": { "type": "string" },
        "consent": { "const": true }
      }
    },
    "FacesEnrollResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["person_id"],
      "properties": { "person_id": { "type": "string" } }
    },
    "FacesMatchRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["embedding", "model_version"],
      "properties": {
        "embedding": { "type": "array", "items": { "type": "number" }, "minItems": 64, "maxItems": 1024 },
        "model_version": { "type": "string" }
      }
    },
    "FacesMatchResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["match", "similarity"],
      "properties": {
        "match": { "type": ["string", "null"] },
        "similarity": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "RouteRequestQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "destination", "mode"],
      "description": "Sent as query parameters: origin=lat,lon & destination=<lat,lon or text> & mode=walking",
      "properties": {
        "origin": { "type": "string", "pattern": "^-?[0-9.]+,-?[0-9.]+$" },
        "destination": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mode": { "const": "walking" }
      }
    },
    "RouteStep": {
      "type": "object", "additionalProperties": false,
      "required": ["instruction", "maneuver", "distance_m", "end"],
      "properties": {
        "instruction": { "type": "string", "maxLength": 300 },
        "maneuver": { "enum": ["start", "straight", "turn_left", "turn_right", "slight_left", "slight_right", "u_turn", "arrive", "other"] },
        "distance_m": { "type": "number", "minimum": 0 },
        "end": { "$ref": "common.schema.json#/$defs/LatLon" }
      }
    },
    "RouteResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["steps", "polyline", "distance_m", "duration_s"],
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/RouteStep" } },
        "polyline": { "type": "string" },
        "distance_m": { "type": "number", "minimum": 0 },
        "duration_s": { "type": "number", "minimum": 0 },
        "destination_name": { "type": ["string", "null"] }
      }
    },
    "SosRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["lat", "lon", "accuracy_m", "fix_age_s", "ts", "contact_ids"],
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "accuracy_m": { "type": "number", "minimum": 0 },
        "fix_age_s": { "type": "number", "minimum": 0 },
        "ts": { "$ref": "common.schema.json#/$defs/TimestampMs" },
        "contact_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SosResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted"],
      "properties": { "accepted": { "type": "boolean" } }
    }
  }
}
