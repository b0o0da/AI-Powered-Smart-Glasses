{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avn.local/contracts/android.schema.json",
  "title": "On-phone shared types",
  "description": "Types that cross module seams inside the Android app. Not sent to the backend except where an endpoint embeds them.",
  "$defs": {
    "SpeechRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utterance_id", "text", "level", "source", "interruptible"],
      "properties": {
        "utterance_id": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "level": { "$ref": "common.schema.json#/$defs/Level" },
        "source": { "$ref": "common.schema.json#/$defs/Source" },
        "interruptible": { "type": "boolean" },
        "event_id": { "type": ["string", "null"] }
      }
    },
    "ActionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "requires_confirmation"],
      "properties": {
        "steps": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/PlanStepItem" } },
        "requires_confirmation": { "type": "boolean" },
        "spoken_ack": { "type": ["string", "null"], "maxLength": 200 },
        "clarification": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "PlanStepItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step"],
      "properties": {
        "step": { "$ref": "common.schema.json#/$defs/PlanStep" },
        "arg": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "NodeInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "clickable", "scrollable", "is_password"],
      "properties": {
        "text": { "type": "string", "maxLength": 2000 },
        "content_description": { "type": ["string", "null"] },
        "view_id": { "type": ["string", "null"] },
        "class_name": { "type": ["string", "null"] },
        "clickable": { "type": "boolean" },
        "scrollable": { "type": "boolean" },
        "is_password": { "type": "boolean" },
        "bounds": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 }
      }
    },
    "ScreenSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "screen_type", "nodes", "text", "clickable_labels", "flags"],
      "properties": {
        "package": { "type": "string" },
        "screen_type": { "$ref": "common.schema.json#/$defs/ScreenType" },
        "nodes": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/NodeInfo" } },
        "text": { "type": "string", "maxLength": 8000 },
        "clickable_labels": { "type": "array", "items": { "type": "string" } },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secure": { "type": "boolean" },
            "empty": { "type": "boolean" },
            "unlabeled": { "type": "boolean" },
            "deny_listed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
